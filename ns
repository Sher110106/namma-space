def sha256_of(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as fh:
        for b in iter(lambda: fh.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def cmd_package(a) -> int:
    name = valid_name(a.name)
    run = local_run(name)
    if not run.exists():
        die(f"{run} does not exist; run ./ns pull {name} first")
    out = run / "package"
    web_bytes = sum(f.stat().st_size for f in (run / "80_web").rglob("*") if f.is_file()) if (run / "80_web").is_dir() else 0
    need = 0.05 + 1.1 * web_bytes / 1e9
    if free_gb(run) < need:
        die(f"only {free_gb(run):.2f} GB free on the Mac; packaging needs about {need:.2f} GB", 20)
    if out.exists():
        shutil.rmtree(out)
    out.mkdir()
    made, missing = [], []

    web = run / "80_web"
    if web.is_dir():
        z = out / "05_Viewer_Offline.zip"
        with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
            for f in sorted(web.rglob("*")):
                if f.is_file():
                    zf.write(f, f"web/{f.relative_to(web)}")
            zf.writestr("web/START_HERE.txt",
                        f"Offline viewer. In this folder run:\n  python3 -m http.server 5178\n"
                        f"then open http://127.0.0.1:5178/?scene={name}\n")
        made.append(z)
    else:
        missing.append("05_Viewer_Offline.zip (no 80_web/; run ./ns bundle)")

    res = out / "06_Results"
    res.mkdir()
    for fn in ("report.html", "report.json", "timings.json", "run.json"):
        if (run / fn).exists():
            shutil.copy2(run / fn, res / fn)
            made.append(res / fn)
        else:
            missing.append(f"06_Results/{fn}")
    held = run / "60_export" / "heldout"
    if held.is_dir():
        shutil.copytree(held, res / "heldout")
        made.append(res / "heldout")
    evald = REPO / "eval" / "results"
    for j in sorted(evald.glob("*.json")) if evald.is_dir() else []:
        shutil.copy2(j, res / j.name)
        made.append(res / j.name)

    inp = out / "04_Inputs_Used"
    inp.mkdir()
    meta = run / "input" / "meta.json"
    if meta.exists():
        shutil.copy2(meta, inp / "meta.json")
        m = json.loads(meta.read_text())
        lines = [f"height_cm: {m.get('height_cm')}"] + [f"{x['what']}: {x['metres']} m ({x.get('method', '')})"
                                                         for x in m.get("measures", [])]
        (inp / "measurements.txt").write_text("\n".join(lines) + "\n")
        made.append(inp / "measurements.txt")
    else:
        missing.append("04_Inputs_Used/measurements.txt")
    for f in sorted((run / "input").glob("*")) if (run / "input").is_dir() else []:
        if f.is_file() and f.suffix.lower() in (".mp4", ".mov", ".m4v", ".jpg", ".jpeg", ".png") and a.with_inputs:
            shutil.copy2(f, inp / f.name)
            made.append(inp / f.name)
    if not a.with_inputs:
        missing.append("04_Inputs_Used/<original videos> (add --with-inputs to copy them)")

    code = out / "03_Code_Repository"
    code.mkdir()
    head = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--verify", "HEAD"], capture_output=True)
    if head.returncode == 0:
        z = code / f"namma-space-{git_sha()}.zip"
        subprocess.run(["git", "-C", str(REPO), "archive", "--format=zip", "-o", str(z), "HEAD"], check=True)
        made.append(z)
    else:
        missing.append("03_Code_Repository/ (the repo has no commit yet; root commits first)")

    for want in ("00_START_HERE_Proof_of_Concept_and_Links.pdf", "01_Technical_Abstract.pdf", "02_Demo_Video.mp4", "02_Demo_Video.srt"):
        found = None
        for base in ([Path(a.extra)] if a.extra else []) + [REPO / "docs" / "build", REPO / "docs", REPO / "video" / "out", REPO / "video"]:
            if (base / want).exists():
                found = base / want
                break
        if found:
            shutil.copy2(found, out / want)
            made.append(out / want)
        else:
            missing.append(f"{want} (not found; pass --extra DIR holding it)")

    lines = ["Namma Space Round 1 package", f"run: {name}", f"git: {git_sha()}",
             f"built: {dt.datetime.now().astimezone().isoformat(timespec='seconds')}", "", "files:"]
    for f in sorted(out.rglob("*")):
        if f.is_file():
            lines.append(f"  {f.relative_to(out)}  {f.stat().st_size / 1e6:.2f} MB  sha256:{sha256_of(f)[:16]}")
    lines += ["", "missing:"] + [f"  {m}" for m in missing]
    (out / "MANIFEST.txt").write_text("\n".join(lines) + "\n")
    say("\n".join(lines))
    say(f"\npackage at {out}")
    return 0


def public_files(name: str) -> list:
    web = local_run(name) / "80_web"
    return [(f.relative_to(web), f.stat().st_size) for f in sorted(web.rglob("*")) if f.is_file()] if web.is_dir() else []


def cmd_publish(a) -> int:
    name = valid_name(a.name)
    files = public_files(name)
    total = sum(s for _, s in files)
    say(f"publish plan for {name} (nothing is sent in a dry run)")
    say("  1. GitHub repo (public): the source tree at the current commit; git: " + git_sha())
    say(f"  2. GitHub Pages (gh-pages branch of the same repo): runs/{name}/80_web, {len(files)} files, {total / 1e6:.1f} MB")
    big = [(str(p), s) for p, s in files if s > 99 * 1024 * 1024]
    if big:
        say("     BLOCKER: files at or over 100 MiB (GitHub's limit): " + ", ".join(f"{p} ({s / 1e6:.0f} MB)" for p, s in big))
    for p, s in files[:40]:
        say(f"       {p}  {s / 1e6:.2f} MB")
    if len(files) > 40:
        say(f"       ... and {len(files) - 40} more")
    say("  3. Hugging Face mirror (optional): needs your account; not done by this command")
    say("  4. Public URL after Pages builds: https://<user>.github.io/<repo>/?scene=" + name)
    if not files:
        say("  NOTE: no 80_web/ yet, so there is nothing to publish; run ./ns bundle " + name)
    if not a.execute:
        say("\ndry run only. To publish for real: ./ns publish %s --execute (asks you to type a phrase)." % name)
        return 0
    phrase = f"PUBLISH {name} TO THE PUBLIC INTERNET"
    if not sys.stdin.isatty():
        die("a real publish needs an interactive terminal where you type the confirmation phrase", 2)
    say(f"\nThis makes the files above public and cannot be taken back. Type exactly:\n  {phrase}")
    typed = input("> ").strip()
    if typed != phrase:
        say("phrase did not match; nothing published")
        return 2
    return real_publish(name, files)


def real_publish(name: str, files: list) -> int:
    """Push the repo and the gh-pages branch. UNTESTED by design (never run during the build)."""
    if not files:
        die("nothing to publish", 2)
    web = local_run(name) / "80_web"
    if subprocess.run(["git", "-C", str(REPO), "remote", "get-url", "origin"], capture_output=True).returncode != 0:
        die("no git remote 'origin'; create the GitHub repo and add the remote first", 2)
    with tempfile.TemporaryDirectory() as td:
        work = Path(td) / "pages"
        shutil.copytree(web, work)
        (work / ".nojekyll").write_text("")
        for cmd in (["git", "init", "-q", "-b", "gh-pages"], ["git", "add", "-A"],
                    ["git", "-c", "user.name=ns", "-c", "user.email=ns@localhost", "commit", "-q", "-m", f"publish {name}"]):
            subprocess.run(cmd, cwd=work, check=True)
        url = subprocess.run(["git", "-C", str(REPO), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
        subprocess.run(["git", "push", "-f", url, "gh-pages"], cwd=work, check=True)
    say("pushed gh-pages. Enable Pages for that branch in the repo settings, then test the URL logged out.")
    return 0


# ------------------------------------------------------------------ test

def cmd_test(a) -> int:
    pkg = a.pkg
    if pkg in ("e2e", "wp0", "common", "remote", "report", "ns"):
        dirs = [REPO / "test" / "e2e"]
    elif pkg == "all":
        dirs = [REPO / "test" / "e2e"] + sorted(p for p in (REPO / "test" / "unit").glob("*") if p.is_dir())
    else:
        d = REPO / "test" / "unit" / pkg
        if not d.is_dir():
            die(f"no tests at test/unit/{pkg}/ (packages: " + ", ".join(sorted(p.name for p in (REPO / 'test' / 'unit').glob('*'))) + ")")
        dirs = [d]
    if a.remote:
        if sync_code(quiet=True) != 0:
            return 20
        image = a.image or "namma-space-gpu:0.1"
        rc = 0
        for d in dirs:
            rel = d.relative_to(REPO)
            cmd = (f"{RROOT}/bin/nsdocker rh-test-{pkg} {image} sh -c "
                   + shlex.quote(f"cd /w/repo && PYTHONPATH=/w/repo python3 -m unittest discover -s {rel} -p 'test*.py'"))
            res = subprocess.run(["ssh", *SSH_OPTS, HOST, cmd])
            rc = rc or res.returncode
        return rc
    rc = 0
    env = dict(os.environ, PYTHONPATH=str(REPO) + os.pathsep + os.environ.get("PYTHONPATH", ""))
    for d in dirs:
        script = d / "run_tests.sh"
        if script.exists():
            r = subprocess.run(["bash", str(script)], cwd=str(REPO), env=env)
        else:
            r = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", str(d), "-p", "test*.py"] + (["-v"] if a.verbose else []),
                               cwd=str(REPO), env=env)
        rc = rc or r.returncode
    return rc


# ------------------------------------------------------------------ main

def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="ns", description="Namma Space: phone video to a walkable splat twin",
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", help="check ssh, disk, GPU, images, Mac tools, copy speed").set_defaults(fn=cmd_doctor)

    p = sub.add_parser("sync", help="rsync code to tyrone")
    p.add_argument("subdir", nargs="?")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("check", help="preflight a video on the Mac")
    p.add_argument("videos", nargs="+")
    p.add_argument("--name", help="also write runs/<name>/00_preflight/check.json")
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("run", help="upload, run all stages on tyrone, pull, bundle, verify, report")
    p.add_argument("video", nargs="?")
    p.add_argument("--frames")
    p.add_argument("--name", required=True)
    p.add_argument("--height", type=float, help="your height in cm (scale cue)")
    p.add_argument("--measure", action="append", default=[], help="what=metres[:method], e.g. length=4.12")
    p.add_argument("--note")
    p.add_argument("--kind", choices=["captured", "public", "fixture"], help="provenance for the bundle (default captured)")
    p.add_argument("--license")
    p.add_argument("--attribution")
    p.add_argument("--source")
    p.add_argument("--title")
    p.add_argument("--take-b", help="second video; runs as <name>-b in parallel")
    p.add_argument("--quick", action="store_true", help="7k-step training")
    p.add_argument("--geometry", action="store_true", help="also run the optional TSDF mesh stage (55_geometry, P1)")
    p.add_argument("--manual-override", action="append", default=[],
                   help="record a manual step in run.json manual_overrides (e.g. why a run was restarted)")
    p.add_argument("--from", dest="from_stage", choices=STAGES)
    p.add_argument("--to", choices=STAGES)
    p.add_argument("--opt", action="append", default=[], help="STAGE:ARG passed to one stage")
    p.add_argument("--runner-flag", action="append", default=[], help="extra flag for ns_remote.py, e.g. --stub-dir=test/e2e/stubs")
    p.add_argument("--stub-cfg", help="JSON file uploaded as runs/<name>/stub_cfg.json (test stubs)")
    p.add_argument("--no-check", action="store_true")
    p.add_argument("--no-sync", action="store_true")
    p.add_argument("--no-pull", action="store_true")
    p.add_argument("--detach", action="store_true", help="start the run and return")
    p.add_argument("--dry-run", action="store_true", help="upload, then print the stage plan without running anything")
    p.add_argument("--force", action="store_true", help="go on after a FAIL check or a low-disk pull warning")
    p.add_argument("--serve", action="store_true")
    p.add_argument("--open", action="store_true", help="open report.html when done")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("status", help="stage table of a run (no name: list all runs)")
    p.add_argument("name", nargs="?")
    p.add_argument("--tail", type=int, default=5)
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("pull", help="rsync results to runs/<name>/")
    p.add_argument("name")
    p.add_argument("--light", action="store_true", help="JSON, logs and figures only")
    p.add_argument("--with-frames", action="store_true")
    p.add_argument("--with-ply", action="store_true")
    p.add_argument("--all", action="store_true")
    p.add_argument("--force", action="store_true", help="pull even with little free disk")
    p.set_defaults(fn=cmd_pull)

    for nm, fn in (("bundle", cmd_bundle), ("verify", cmd_verify), ("report", cmd_report)):
        p = sub.add_parser(nm, help=f"Mac-side {nm} for a pulled run")
        p.add_argument("name")
        p.set_defaults(fn=fn)

    p = sub.add_parser("serve", help="serve runs/<name>/80_web on 127.0.0.1")
    p.add_argument("name")
    p.add_argument("--port", type=int, default=PORT)
    p.add_argument("--dir")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("rescale", help="change scale without retraining")
    p.add_argument("name")
    p.add_argument("--scale", type=float, help="total scale factor relative to the automatic estimate (1.0 = automatic)")
    p.add_argument("--factor", type=float, help="multiply the current scale by this (1.05 = 5%% larger)")
    p.add_argument("--use-measures", action="store_true", help="adopt the scale of your tape distances")
    p.add_argument("--no-sync", action="store_true")
    p.add_argument("--runner-flag", action="append", default=[])
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_rescale)

    p = sub.add_parser("package", help="assemble the Drive folder contents")
    p.add_argument("name")
    p.add_argument("--with-inputs", action="store_true", help="copy the original videos and photos")
    p.add_argument("--extra", help="folder holding the finished PDFs and the video")
    p.set_defaults(fn=cmd_package)

    p = sub.add_parser("publish", help="dry run of what goes public; --execute asks for a typed phrase")
    p.add_argument("name")
    p.add_argument("--dry-run", action="store_true", help="(default) print the plan only")
    p.add_argument("--execute", action="store_true")
    p.set_defaults(fn=cmd_publish)

    p = sub.add_parser("test", help="run a package's tests")
    p.add_argument("pkg")
    p.add_argument("--remote", action="store_true", help="run inside a container on tyrone")
    p.add_argument("--image")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(fn=cmd_test)
    return ap


def main(argv: list | None = None) -> int:
    a = build_parser().parse_args(argv)
    try:
        return int(a.fn(a) or 0)
    except KeyboardInterrupt:
        say("\ninterrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
