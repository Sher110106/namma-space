# ------------------------------------------------------------------ status

def cmd_status_all() -> int:
    script = f"""cd {RROOT}/runs 2>/dev/null || exit 0
for d in */; do d=${{d%/}}; [ -f $d/status.json ] || continue
python3 - "$d" <<'PY'
import json, sys
d = sys.argv[1]
s = json.load(open(d + "/status.json"))
cur = [k for k, v in (s.get("stages") or {{}}).items() if v.get("state") == "running"]
print(f"{{d:<28}} {{s.get('state','?'):<9}} exit={{s.get('exit')}} {{'running: ' + ','.join(cur) if cur else ''}} {{s.get('updated','')}}")
PY
done"""
    res = ssh(script, timeout=60)
    if res.returncode == 255:
        say("ns: cannot reach tyrone (ssh failed)")
        return 20
    say(res.stdout.rstrip() or "no runs with a status.json on tyrone")
    return 0


def cmd_status(a) -> int:
    if not a.name:
        return cmd_status_all()
    name = valid_name(a.name)
    st = read_status(name)
    if st is None:
        say("ns: cannot reach tyrone (ssh failed)")
        return 20
    if st.get("state") in ("none", "unreadable"):
        say(f"{name}: no status.json on tyrone ({st.get('state')})")
        return 1
    say(f"{name}: {st.get('state')}  (pid {st.get('pid')}, started {st.get('started')}, updated {st.get('updated')})")
    for s in STAGES:
        v = (st.get("stages") or {}).get(s)
        if not v:
            continue
        line = f"  {s:<9}{v.get('state', '?'):<16}"
        if v.get("seconds") is not None:
            line += f"{v['seconds']:>8}s"
        elif v.get("elapsed_s") is not None:
            line += f"{v['elapsed_s']:>8}s running"
        if v.get("note"):
            line += f"  {v['note']}"
        elif v.get("last_line") and v.get("state") in ("running",) or str(v.get("state", "")).startswith("exit-"):
            line += f"  {v.get('last_line', '')}"
        say(line)
    if st.get("exit") is not None:
        say(f"exit {st['exit']}" + ("  INCOMPLETE (a stage module is missing)" if st.get("incomplete") else ""))
    tail = ssh(f"tail -n {a.tail} {remote_run(name)}/logs/runner.log 2>/dev/null", timeout=20).stdout
    if a.tail and tail.strip():
        say("runner.log:")
        say(textwrap_indent(tail))
    return 0


def textwrap_indent(s: str) -> str:
    return "\n".join("  " + ln for ln in s.rstrip().splitlines())


# ------------------------------------------------------------------ serve

class Handler(http.server.SimpleHTTPRequestHandler):
    extensions_map = {**http.server.SimpleHTTPRequestHandler.extensions_map, ".mjs": "text/javascript",
                      ".js": "text/javascript", ".wasm": "application/wasm", ".spz": "application/octet-stream",
                      ".splat": "application/octet-stream", ".json": "application/json"}

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, fmt, *args):  # quiet
        pass


def serve(name: str, port: int, directory: Path | None = None) -> int:
    web = directory or (local_run(name) / "80_web")
    if not web.is_dir():
        die(f"{web} does not exist; run ./ns pull {name} and ./ns bundle {name} first")

    class H(Handler):
        def __init__(self, *args, **kw):
            super().__init__(*args, directory=str(web), **kw)

    socketserver.TCPServer.allow_reuse_address = True
    try:
        srv = socketserver.ThreadingTCPServer(("127.0.0.1", port), H)
        srv.daemon_threads = True
    except OSError as exc:
        die(f"cannot listen on 127.0.0.1:{port}: {exc}", 20)
    say(f"serving {web}\n  http://127.0.0.1:{port}/?scene={name}\n  Ctrl-C to stop")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        say("\nstopped")
    return 0


def cmd_serve(a) -> int:
    return serve(valid_name(a.name), a.port, Path(a.dir) if a.dir else None)


# ------------------------------------------------------------------ rescale

def cmd_rescale(a) -> int:
    name = valid_name(a.name)
    opts = []
    if a.use_measures:
        opts.append("--use-measures")
    if a.scale is not None:            # total factor relative to the automatic scale (rescale.py --set-total)
        opts.append(f"--set-total={a.scale}")
    if a.factor is not None:           # multiply the current factor (rescale.py --scale)
        opts.append(f"--scale={a.factor}")
    if len(opts) > 1:
        die("give only one of --scale, --factor, --use-measures")
    if not opts:
        die("give --scale K, --factor K or --use-measures")
    t0 = time.time()
    if not a.no_sync and sync_code(quiet=True) != 0:
        return 20
    flags = ["--rescale"] + sum([["--opt", f"rescale:{o}"] for o in opts], [])
    for rf in a.runner_flag or []:
        flags += shlex.split(rf)
    pid = launch_remote(name, flags)
    if pid is None:
        say("ns: could not start the runner on tyrone")
        return 20
    results = poll_runs({name: pid}, light_pull=False)
    code = results.get(name, 20)
    if code not in (0, 11, 30):   # 30: the grid stage used a fallback; the rescale itself went through
        say(f"ns: rescale failed with exit {code}; see runs/{name}/logs/rescale.log and grid.log on tyrone")
        return code
    if cmd_pull(argparse.Namespace(name=name, light=False, force=a.force, with_frames=False, with_ply=False, all=False), name, light=False) != 0:
        return 20
    pc = post_pull(name)
    secs = time.time() - t0
    say(f"rescale done in {secs:.0f}s" + ("" if secs <= 300 else "  (over the 5 minute target)"))
    prio = {0: 0, 11: 1, 30: 2, 10: 3, 20: 4}
    return max(code, pc, key=lambda c: prio.get(c, 4))


