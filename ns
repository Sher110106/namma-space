# ------------------------------------------------------------------ small helpers

def say(msg: str = "") -> None:
    print(msg, flush=True)


def stamp() -> str:
    return dt.datetime.now().strftime("%H:%M:%S")


def die(msg: str, code: int = 2) -> None:
    print(f"ns: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def valid_name(name: str) -> str:
    if not RUN_NAME_RE.match(name):
        die(f"run name {name!r} must match {RUN_NAME_RE.pattern} (lowercase letters, digits, - _ .)")
    return name


def ssh(cmd: str, timeout: float = 60, stdin=None, text: bool = True) -> subprocess.CompletedProcess:
    """Run a shell command on tyrone. Never raises on a non-zero exit; returns 255 on ssh trouble."""
    try:
        return subprocess.run(["ssh", *SSH_OPTS, HOST, cmd], capture_output=True, text=text, timeout=timeout,
                              stdin=stdin)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 255, "", "ssh timed out")


def rsync(args: list, quiet: bool = False) -> int:
    cmd = ["rsync", "-a", "-e", "ssh " + " ".join(SSH_OPTS), *args]
    if quiet:
        return subprocess.run(cmd, capture_output=True).returncode
    return subprocess.run(cmd).returncode


def free_gb(path: Path) -> float:
    p = path
    while not p.exists() and p != p.parent:
        p = p.parent
    return shutil.disk_usage(p).free / 1e9


def git_sha() -> str:
    try:
        sha = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"], capture_output=True,
                             text=True).stdout.strip()
        if not sha:
            return "nocommit"
        dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain"], capture_output=True,
                               text=True).stdout.strip()
        return sha + ("-dirty" if dirty else "")
    except OSError:
        return "nogit"


def remote_run(name: str) -> str:
    return f"{RROOT}/runs/{name}"


def local_run(name: str) -> Path:
    return LOCAL_RUNS / name


REMOTE_PREFIXES = ("tyrone:", "remote:")
IMAGE_SUFFIXES = (".jpg", ".jpeg", ".png")


def remote_path(arg: str | None) -> str | None:
    """'tyrone:/abs/path' (or 'remote:/abs/path') names a file or folder already on the GPU host."""
    if arg and arg.startswith(REMOTE_PREFIXES):
        p = arg.split(":", 1)[1]
        if not p.startswith("/"):
            die(f"{arg}: give an absolute path on the GPU host, e.g. tyrone:/home/sher/inbox/IMG_0421.MOV")
        return p
    return None


def remote_probe(path: str, kind: str) -> dict | None:
    """Size of a remote video, or image count and bytes of a remote frames folder. None if missing."""
    q = shlex.quote(path)
    if kind == "video":
        res = ssh(f"test -f {q} && stat -L -c %s {q}", timeout=30)
        if res.returncode != 0 or not res.stdout.strip().isdigit():
            return None
        return {"bytes": int(res.stdout.strip())}
    res = ssh(f"test -d {q} && find -L {q} -maxdepth 1 -type f -printf '%f %s\\n'", timeout=60)
    if res.returncode != 0:
        return None
    files = [ln.rsplit(" ", 1) for ln in res.stdout.splitlines() if " " in ln]
    imgs = [(n, int(b)) for n, b in files if n.lower().endswith(IMAGE_SUFFIXES)]
    return {"files": len(imgs), "bytes": sum(b for _, b in imgs)}


def place_remote_input(src: str, rd: str, kind: str) -> int:
    """Put a file or folder that is already on tyrone into runs/<name>/input/ without copying it over ssh.

    Under the namma-space root (which containers see as /w) it becomes a relative symlink. Elsewhere it is
    hard-linked (same disk, no extra space) or, failing that, copied, because containers cannot see it."""
    import posixpath
    dst = f"{rd}/input/frames" if kind == "frames" else f"{rd}/input/{posixpath.basename(src)}"
    script = f"""
set -e
src=$(readlink -f {shlex.quote(src)})
dst={shlex.quote(dst)}
root=$(readlink -f {shlex.quote(RROOT)})
mkdir -p {shlex.quote(rd)}/input
if [ -L "$dst" ]; then rm "$dst"; fi
if [ -e "$dst" ]; then echo "EXISTS $dst"; exit 0; fi
case "$src" in
  "$root"/*)
    rel=$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$src" "$(dirname "$dst")")
    ln -s "$rel" "$dst"; echo "LINK $rel" ;;
  *)
    if [ -d "$src" ]; then cp -rl "$src" "$dst" 2>/dev/null || cp -r "$src" "$dst"; else ln "$src" "$dst" 2>/dev/null || cp "$src" "$dst"; fi
    echo "COPY $src" ;;
esac
"""
    res = ssh(script, timeout=600)
    if res.returncode != 0:
        say(f"ns: could not place {src} in runs/: {res.stderr.strip()[:200]}")
        return 20
    say(f"[{stamp()}] input on tyrone: {res.stdout.strip()} -> {dst}")
    return 0


def remote_check(name: str, video_in_run: str) -> int:
    """Run the preflight check on tyrone (the host has no ffmpeg; the gpu image does), then copy check.json back."""
    import posixpath
    rd_c = f"/w/runs/{name}"
    vid_c = f"{rd_c}/input/{posixpath.basename(video_in_run)}"
    cmd = (f"{RROOT}/bin/nsdocker ns-{name}-check namma-space-gpu:0.1 "
           f"python3 pipeline/ingest/check_mac.py {shlex.quote(vid_c)} --run-dir {shlex.quote(rd_c)}")
    say(f"[{stamp()}] preflight check on tyrone: {posixpath.basename(video_in_run)}")
    res = ssh(cmd, timeout=900)
    out = (res.stdout or "") + (res.stderr or "")
    for ln in out.splitlines():
        noise = ("==", "CUDA", "Container image", "This container", "By pulling", "https://", "A copy of", "WARNING: The NVIDIA",
                 "Use the NVIDIA", "https://docs.nvidia")
        if not ln.strip().startswith(noise) and ln.strip():
            say("  " + ln)
    lr = local_run(name)
    (lr / "00_preflight").mkdir(parents=True, exist_ok=True)
    rsync([f"{HOST}:{remote_run(name)}/00_preflight/", str(lr / "00_preflight") + "/"], quiet=True)
    return res.returncode


# ------------------------------------------------------------------ sync

def sync_code(subdir: str = "", quiet: bool = False) -> int:
    src = REPO / subdir if subdir else REPO
    if not src.exists():
        die(f"{src} does not exist")
    dst = f"{HOST}:{RROOT}/repo/{subdir + '/' if subdir else ''}"
    args = []
    for e in SYNC_EXCLUDES:
        args += ["--exclude", e]
    rc = rsync([*args, str(src) + "/", dst], quiet=quiet)
    if rc != 0:
        say(f"ns: rsync failed (exit {rc})")
    return rc


def cmd_sync(a) -> int:
    t0 = time.time()
    rc = sync_code(a.subdir or "")
    say(f"sync {'ok' if rc == 0 else 'FAILED'} in {time.time() - t0:.1f}s -> {HOST}:{RROOT}/repo/")
    return 0 if rc == 0 else 20


# ------------------------------------------------------------------ doctor

class Report:
    def __init__(self) -> None:
        self.fails = 0
        self.warns = 0

    def line(self, level: str, what: str, detail: str = "") -> None:
        if level == "FAIL":
            self.fails += 1
        if level == "WARN":
            self.warns += 1
        say(f"  {level:<4}  {what:<22} {detail}")


def cmd_doctor(a) -> int:
    t_start = time.time()
    r = Report()
    say(f"ns doctor  ({HOST}, {RROOT})")
    say("tyrone")
    t0 = time.time()
    probe = ssh("true", timeout=15)
    rtt = time.time() - t0
    if probe.returncode != 0:
        r.line("FAIL", "ssh", f"cannot connect: {probe.stderr.strip()[:120]}")
        say(f"doctor stopped: no ssh ({time.time() - t_start:.1f}s)")
        return 1
    r.line("PASS" if rtt < 3 else "WARN", "ssh", f"connected in {rtt:.2f}s")

    script = f"""
cd {RROOT} 2>/dev/null || {{ echo "ERR root missing"; exit 0; }}
echo "DF $(df --output=avail -BG / | tail -1 | tr -dc 0-9)"
echo "GPU $(nvidia-smi --query-gpu=name,memory.used,memory.total,memory.free --format=csv,noheader,nounits 2>&1 | head -1)"
echo "MEM $(free -g | awk '/Mem:/ {{print $7}}')"
echo "PY $(python3 --version 2>&1)"
for i in namma-colmap:0.1 namma-colmap:0.2 namma-space-gpu:0.1 namma-space-gpu:0.2 namma-node:0.1; do
  d=$(docker image inspect --format '{{{{.Id}}}} {{{{.Size}}}}' $i 2>/dev/null) && echo "IMG $i $d" || echo "IMG $i missing"
done
echo "OURS $(docker ps --format '{{{{.Names}}}}' | grep -c '^ns-')"
echo "OTHERS $(docker ps --format '{{{{.Names}}}}' | grep -vc '^ns-')"
echo "NSDOCKER $(test -x bin/nsdocker && echo ok || echo missing)"
echo "RUNNER $(test -f repo/pipeline/remote/ns_remote.py && echo ok || echo missing)"
echo "LOCKS $(ls locks 2>/dev/null | tr '\\n' ' ')"
echo "RUNS $(du -sm runs 2>/dev/null | cut -f1)"
"""
    res = ssh(script, timeout=40)
    info: dict = {}
    imgs = []
    for ln in res.stdout.splitlines():
        k, _, v = ln.partition(" ")
        if k == "IMG":
            imgs.append(v)
        else:
            info[k] = v
    if "ERR" in info:
        r.line("FAIL", "layout", f"{RROOT} missing on tyrone")
    free = float(info.get("DF") or 0)
    r.line("PASS" if free >= 25 else ("WARN" if free >= 15 else "FAIL"), "disk free (tyrone)",
           f"{free:.0f} GB (floor 15 GB; budget 6 GB per run)")
    gpu = (info.get("GPU") or "").split(",")
    if len(gpu) >= 4:
        gfree = float(gpu[3])
        r.line("PASS" if gfree >= 12000 else "WARN", "GPU memory free",
               f"{gfree / 1024:.1f} GB free of {float(gpu[2]) / 1024:.0f} GB ({gpu[0].strip()}); a GPU job needs 12 GB")
    else:
        r.line("FAIL", "GPU", info.get("GPU", "nvidia-smi gave nothing")[:100])
    r.line("PASS" if float(info.get("MEM") or 0) >= 25 else "WARN", "RAM available", f"{info.get('MEM', '?')} GB")
    r.line("PASS" if info.get("PY", "").startswith("Python 3") else "FAIL", "python3 (host)", info.get("PY", ""))
    for im in imgs:
        parts = im.split()
        if len(parts) >= 3 and parts[1] != "missing":
            digest = parts[1].replace("sha256:", "")[:12]
            r.line("PASS", parts[0], f"sha256:{digest}  {int(parts[2]) / 1e9:.1f} GB")
        else:
            lvl = "FAIL" if parts[0] in ("namma-colmap:0.2", "namma-space-gpu:0.1") else "WARN"
            r.line(lvl, parts[0], "not present on tyrone")
    r.line("PASS", "our containers", f"{info.get('OURS', '?')} running (cap 3); others: {info.get('OTHERS', '?')} (never touched)")
    r.line("PASS" if info.get("NSDOCKER") == "ok" else "FAIL", "bin/nsdocker", info.get("NSDOCKER", "?"))
    r.line("PASS" if info.get("RUNNER") == "ok" else "WARN", "repo/ns_remote.py",
           info.get("RUNNER", "?") + ("" if info.get("RUNNER") == "ok" else "  (run ./ns sync)"))
    r.line("PASS", "runs/ size", f"{info.get('RUNS', '?')} MB; locks: {info.get('LOCKS', '').strip() or 'none'}")

    say("Mac")
    for tool in ("ffmpeg", "ffprobe", "node", "rsync", "python3", "caffeinate"):
        p = shutil.which(tool)
        if not p:
            r.line("FAIL" if tool in ("ffmpeg", "ffprobe", "rsync", "python3") else "WARN", tool, "not found")
            continue
        ver = ""
        if tool in ("ffmpeg", "node", "python3"):
            flag = "-version" if tool == "ffmpeg" else "--version"
            ver = subprocess.run([tool, flag], capture_output=True, text=True).stdout.splitlines()[:1]
            ver = ver[0][:60] if ver else ""
        r.line("PASS", tool, ver or p)
    chrome = glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium_headless_shell*/*/chrome-headless-shell"))
    r.line("PASS" if chrome else "WARN", "headless chrome", "found" if chrome else "playwright chromium_headless_shell missing")
    mfree = free_gb(REPO)
    r.line("PASS" if mfree >= 10 else ("WARN" if mfree >= 3 else "FAIL"), "disk free (Mac)",
           f"{mfree:.1f} GB at {REPO}" + ("" if mfree >= 10 else "  (pulls and zips need room; free some space)"))

    say("copy test (100 MB each way)")
    mb = 100
    rpath = f"{RROOT}/runs/rh-doctor.bin"
    chunk = os.urandom(1 << 20)
    t0 = time.time()
    p = subprocess.Popen(["ssh", *SSH_OPTS, HOST, f"cat > {rpath}"], stdin=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        for _ in range(mb):
            p.stdin.write(chunk)
        p.stdin.close()
        p.wait(timeout=90)
        up = time.time() - t0
        r.line("PASS" if up < 30 else "WARN", "upload", f"{mb / up:.1f} MB/s ({up:.1f}s for {mb} MB)")
    except (OSError, subprocess.TimeoutExpired) as exc:
        p.kill()
        r.line("FAIL", "upload", str(exc)[:100])
        up = 99
    if up < 40:
        t0 = time.time()
        d = subprocess.Popen(["ssh", *SSH_OPTS, HOST, f"cat {rpath}"], stdout=subprocess.PIPE)
        got = 0
        while True:
            b = d.stdout.read(1 << 20)
            if not b:
                break
            got += len(b)
        d.wait()
        down = time.time() - t0
        ok = got == mb * (1 << 20)
        r.line("PASS" if ok and down < 30 else "WARN", "download", f"{got / 1e6 / max(down, 1e-6):.1f} MB/s ({down:.1f}s)"
               + ("" if ok else f"  short read {got}"))
    ssh(f"rm -f {rpath}", timeout=15)

    total = time.time() - t_start
    say(f"doctor: {r.fails} FAIL, {r.warns} WARN, {total:.0f}s" + ("" if total <= 60 else "  (over the 60 s target)"))
    return 1 if r.fails else 0


# ------------------------------------------------------------------ check

def cmd_check(a) -> int:
    script = REPO / "pipeline" / "ingest" / "check_mac.py"
    if not script.exists():
        die("pipeline/ingest/check_mac.py is not present yet (W2 builds it); nothing to check")
    rem = [remote_path(v) for v in a.videos]
    if any(rem):
        # videos already on tyrone: check them there (inside the gpu image, which has ffmpeg)
        if not all(rem):
            die("check Mac videos and tyrone: videos in separate calls")
        bad = 0
        sync_code(quiet=True)
        for rp in rem:
            if remote_probe(rp, "video") is None:
                die(f"no such video on tyrone: {rp}")
            nm = valid_name(a.name) if a.name else "check-" + re.sub(r"[^a-z0-9]+", "-", Path(rp).stem.lower())[:30].strip("-")
            if place_remote_input(rp, remote_run(nm), "video") != 0:
                return 20
            rc = remote_check(nm, rp)
            bad = max(bad, rc)
            say(f"check.json: {local_run(nm) / '00_preflight' / 'check.json'}")
        return bad
    cmd = [sys.executable, str(script), *a.videos]
    if a.name:
        cmd += ["--run-dir", str(local_run(valid_name(a.name)))]
    else:
        cmd += ["--out", ""]
    return subprocess.run(cmd).returncode


# ------------------------------------------------------------------ pull

LIGHT_FILTER = ["--exclude=*.tmp", "--exclude=*.prev", "--exclude=*.failed", "--exclude=.runner.lock",
                "--include=*/", "--include=*.json", "--include=*.txt", "--include=logs/***", "--include=figures/***",
                "--include=*.md", "--exclude=*"]
FULL_EXCLUDES = ["input/", "*.db", "30_undist/images/", "40_align/images", "10_frames/images/", "50_train/*/ply/",
                 "50_train/*/ckpts/", "50_train/*/renders/", "*.tmp", "*.prev", "*.failed", ".runner.lock", "20_sfm/*/sparse/",
                 "60_export/*.ply", "55_geometry/*.ply",   # cleaned PLY and mesh: 100s of MB, not needed on the Mac
                 "20_sfm/*/clean/", "30_undist/sparse/", "40_align/sparse/"]   # COLMAP models: 20-60 MB a run, read only on tyrone


def pull_args(a, name: str, light: bool) -> list:
    dst = local_run(name)
    src = f"{HOST}:{remote_run(name)}/"
    if light:
        return [*LIGHT_FILTER, src, str(dst) + "/"]
    ex = list(FULL_EXCLUDES)
    if getattr(a, "with_frames", False) or getattr(a, "all", False):
        ex = [e for e in ex if e != "10_frames/images/"]
    if getattr(a, "with_ply", False) or getattr(a, "all", False):
        ex = [e for e in ex if e not in ("50_train/*/ply/", "50_train/*/ckpts/", "50_train/*/renders/",
                                         "60_export/*.ply", "55_geometry/*.ply")]
    if getattr(a, "all", False):
        ex = [e for e in ex if e in ("*.tmp", "*.prev", "*.failed", ".runner.lock")]
    args = []
    for e in ex:
        args += ["--exclude", e]
    return args + [src, str(dst) + "/"]


def cmd_pull(a, name: str | None = None, light: bool | None = None) -> int:
    name = valid_name(name or a.name)
    light = a.light if light is None else light
    dst = local_run(name)
    dst.mkdir(parents=True, exist_ok=True)
    args = pull_args(a, name, light)
    # size the transfer first: the Mac disk can be nearly full
    dry = subprocess.run(["rsync", "-a", "--dry-run", "--stats", "-e", "ssh " + " ".join(SSH_OPTS), *args],
                         capture_output=True, text=True)
    m = re.search(r"total size is (\d+)", dry.stdout + dry.stderr)
    need_gb = (int(m.group(1)) / 1e9 if m else 0.0) + 0.1
    if dry.returncode != 0:
        say(f"ns: cannot list runs/{name} on tyrone (rsync exit {dry.returncode}): {dry.stderr.strip()[:150]}")
        return 20
    if free_gb(dst) < need_gb and not getattr(a, "force", False):
        say(f"ns: pull of {name} needs about {need_gb:.2f} GB but the Mac has {free_gb(dst):.2f} GB free. "
            "Free some space, or use --light, or --force.")
        return 20
    t0 = time.time()
    rc = rsync(args)
    if rc != 0:
        say(f"ns: pull failed (rsync exit {rc})")
        return 20
    for stale in dst.glob("*.tmp"):  # half-written stage dirs from an earlier light pull
        shutil.rmtree(stale, ignore_errors=True)
    say(f"pulled {name} ({'light' if light else 'full'}, {need_gb - 0.1:.2f} GB) in {time.time() - t0:.1f}s -> {dst}")
    return 0


# ------------------------------------------------------------------ run

def parse_measures(items: list) -> list:
    out = []
    for it in items or []:
        m = re.match(r"^([A-Za-z_ ]+)=([0-9.]+)(?::(.+))?$", it)
        if not m:
            die(f"--measure needs what=metres[:method], got {it!r}")
        out.append({"what": m.group(1).strip(), "metres": float(m.group(2)), "method": m.group(3) or "tape"})
    return out


def read_status(name: str) -> dict | None:
    res = ssh(f"cat {remote_run(name)}/status.json", timeout=25)
    if res.returncode == 255:
        return None  # ssh trouble
    if res.returncode != 0:
        return {"state": "none"}
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError:
        return {"state": "unreadable"}


def build_runner_flags(a) -> list:
    flags = []
    if a.from_stage:
        flags += ["--from", a.from_stage]
    if a.to:
        flags += ["--to", a.to]
    if a.quick:
        flags += ["--quick"]
    if getattr(a, "geometry", False):
        flags += ["--with-optional"]
    for mo in getattr(a, "manual_override", None) or []:
        flags += [f"--manual-override={mo}"]
    for o in a.opt or []:
        flags += ["--opt", o]
    for rf in a.runner_flag or []:
        flags += shlex.split(rf)
    return flags


def launch_remote(name: str, flags: list) -> int | None:
    """Start ns_remote.py under nohup on tyrone. Returns the pid, 0 when one is already running, None on ssh failure."""
    rd = remote_run(name)
    cmd = f"""
mkdir -p {rd}/logs
if ! flock -n {rd}/.runner.lock true 2>/dev/null; then echo ATTACH; exit 0; fi
cd {RROOT}/repo
nohup python3 pipeline/remote/ns_remote.py {shlex.quote(name)} --git {shlex.quote(git_sha())} {' '.join(shlex.quote(f) for f in flags)} \
  >> {rd}/logs/runner.log 2>&1 < /dev/null &
echo PID $!
"""
    res = ssh(cmd, timeout=30)
    if res.returncode != 0:
        return None
    if "ATTACH" in res.stdout:
        return 0
    m = re.search(r"PID (\d+)", res.stdout)
    return int(m.group(1)) if m else None


def print_stage_changes(name: str, st: dict, seen: dict) -> list:
    """Print new stage states; return names of stages that just finished."""
    finished = []
    for s, v in (st.get("stages") or {}).items():
        key = (v.get("state"), v.get("exit"))
        if seen.get(s) == key:
            continue
        seen[s] = key
        state = v.get("state", "?")
        extra = ""
        if state == "done" or state.startswith("exit-"):
            extra = f" {v.get('seconds', '?')}s"
            finished.append(s)
        if state.startswith("skipped"):
            extra = f" ({v.get('note', '')})" if v.get("note") else ""
        elif v.get("note") and state != "done":
            extra += f" ({v['note']})"
        say(f"[{stamp()}] {name}: {s}: {state}{extra}")
    return finished


def remote_alive(pid: int) -> bool | None:
    """True/False from kill -0 on tyrone; None when ssh fails."""
    res = ssh(f"kill -0 {int(pid)} 2>/dev/null && echo alive || echo gone", timeout=20)
    if res.returncode == 255:
        return None
    return "alive" in res.stdout


def poll_runs(names: dict, light_pull: bool = True, max_ssh_fail_s: float = 1800) -> dict:
    """names: {name: pid-or-0}. Poll status.json until every run has ended. Returns {name: exit code}.

    A runner that died without writing a final status (kill -9, host reboot) is detected with kill -0
    and reported as exit 20, so the poll never hangs.
    """
    results: dict = {}
    seen = {n: {} for n in names}
    last_alive_check = {n: 0.0 for n in names}
    waited_start = {n: time.time() for n in names}
    fail_since: float | None = None
    delay = 2.0
    while len(results) < len(names):
        for n, pid in names.items():
            if n in results:
                continue
            st = read_status(n)
            if st is None:
                fail_since = fail_since or time.time()
                waited = time.time() - fail_since
                say(f"[{stamp()}] ssh unreachable for {waited:.0f}s; the run keeps going on tyrone. Retrying...")
                if waited > max_ssh_fail_s:
                    say(f"ns: giving up on polling {n}. Later: ./ns status {n} ; ./ns pull {n}")
                    results[n] = 20
                continue
            fail_since = None
            state = st.get("state")
            ours = (not pid) or st.get("pid") == pid
            if ours:
                finished = print_stage_changes(n, st, seen[n])
                if finished and light_pull:
                    cmd_pull(argparse.Namespace(name=n, light=True, force=False), n, light=True)
                if state in END_STATES:
                    results[n] = int(st["exit"]) if st.get("exit") is not None else 20
                    continue
            # stale status of an older run, or a running status whose runner may be gone
            target = pid or st.get("pid")
            if target and time.time() - last_alive_check[n] > 20 and (not ours or state in ("running", "starting")):
                last_alive_check[n] = time.time()
                alive = remote_alive(target)
                if alive is False and (not ours or state in ("running", "starting")):
                    if time.time() - waited_start[n] > 10:
                        say(f"ns: the runner (pid {target}) for {n} is gone without a final status. "
                            f"See runs/{n}/logs/runner.log. Resume with: ./ns run --name {n} --from <stage>")
                        tail = ssh(f"tail -n 8 {remote_run(n)}/logs/runner.log", timeout=20).stdout
                        say(textwrap_indent(tail))
                        results[n] = 20
        if len(results) < len(names):
            time.sleep(delay)
            delay = min(5.0, delay + 0.5)
    return results


def cmd_run(a) -> int:
    name = valid_name(a.name)
    names = [name] + ([valid_name(name + "-b")] if a.take_b else [])
    if a.video and a.frames:
        die("give a video or --frames, not both")
    resume_only = not a.video and not a.frames
    caff = None
    try:
        if shutil.which("caffeinate"):
            caff = subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())])
    except OSError:
        caff = None

    uploads = []  # (run name, source Path or remote path str, kind, remote info dict or None)

    def add_video(run_name: str, arg: str) -> None:
        rp = remote_path(arg)
        if rp:
            info = remote_probe(rp, "video")
            if info is None:
                die(f"no such video on tyrone: {rp}")
            uploads.append((run_name, rp, "video", info))
            return
        v = Path(arg).expanduser()
        if not v.is_file():
            die(f"no such video: {v}")
        uploads.append((run_name, v, "video", None))

    if a.video:
        add_video(name, a.video)
    if a.frames:
        rp = remote_path(a.frames)
        if rp:
            info = remote_probe(rp, "frames")
            if info is None:
                die(f"no such frames directory on tyrone: {rp}")
            uploads.append((name, rp, "frames", info))
            n_img = info["files"]
        else:
            f = Path(a.frames).expanduser()
            if not f.is_dir():
                die(f"no such frames directory: {f}")
            uploads.append((name, f, "frames", None))
            n_img = sum(1 for x in f.iterdir() if x.suffix.lower() in IMAGE_SUFFIXES)
        if n_img < 60 and not any(o.startswith("ingest:") for o in a.opt):
            say(f"ns: {n_img} images is below the 60 that ingest wants; it will exit 10. "
                "For a tiny test set add: --opt ingest:--force")
    if a.take_b:
        add_video(name + "-b", a.take_b)

    if not resume_only:
        for n, src, kind, rinfo in uploads:
            lr = local_run(n)
            lr.mkdir(parents=True, exist_ok=True)
            src_name = Path(str(src)).name
            if rinfo is not None:
                files = ([{"name": src_name, "bytes": rinfo["bytes"], "on_host": str(src)}] if kind == "video" else
                         [{"name": "frames/", "files": rinfo["files"], "bytes": rinfo["bytes"], "on_host": str(src)}])
            else:
                files = ([{"name": src.name, "bytes": src.stat().st_size}] if kind == "video" else
                         [{"name": "frames/", "files": sum(1 for x in src.iterdir() if x.is_file() and x.name != ".DS_Store"),
                           "bytes": sum(x.stat().st_size for x in src.iterdir() if x.is_file())}])
            meta = {"name": n, "height_cm": a.height, "measures": parse_measures(a.measure), "notes": a.note or "",
                    "provenance": {k: v for k, v in (("kind", a.kind), ("license", a.license), ("attribution", a.attribution),
                                                     ("source", a.source), ("title", a.title)) if v},
                    "takes": [{"id": "B" if n.endswith("-b") else "A", "kind": kind,
                               "file": src_name if kind == "video" else None,
                               "frames_dir": "frames" if kind == "frames" else None}],
                    "files": files,
                    "created": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
            (lr / "input").mkdir(exist_ok=True)
            (lr / "input" / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
            if kind == "video" and not a.no_check and rinfo is None:
                chk = REPO / "pipeline" / "ingest" / "check_mac.py"
                if chk.exists():
                    say(f"[{stamp()}] preflight check on {src.name}")
                    rc = subprocess.run([sys.executable, str(chk), str(src), "--run-dir", str(lr)]).returncode
                    if rc == 10 and not a.force:
                        say("ns: the check says FAIL (capture problem). Fix it, reshoot, or pass --force to try anyway.")
                        return 10
                else:
                    say("ns: pipeline/ingest/check_mac.py not present; skipping the preflight check")

    if not a.no_sync:
        say(f"[{stamp()}] sync code to tyrone")
        if sync_code(quiet=True) != 0:
            say("ns: code sync failed; is ssh up? (./ns doctor)")
            return 20

    for n, src, kind, rinfo in uploads:
        rd = remote_run(n)
        res = ssh(f"mkdir -p {rd}/input", timeout=30)
        if res.returncode != 0:
            say(f"ns: cannot reach tyrone: {res.stderr.strip()[:120]}")
            return 20
        if rinfo is not None:  # already on tyrone: link it into the run, nothing crosses the network
            rc = place_remote_input(str(src), rd, kind)
        else:
            say(f"[{stamp()}] upload {src.name} -> runs/{n}/input/")
            if kind == "video":
                rc = rsync(["--partial", str(src), f"{HOST}:{rd}/input/"])
            else:
                rc = rsync(["--exclude", ".DS_Store", str(src) + "/", f"{HOST}:{rd}/input/frames/"])
        if rc == 0:
            rc = rsync([str(local_run(n) / "input" / "meta.json"), f"{HOST}:{rd}/input/meta.json"])
        if rc != 0:
            say(f"ns: upload failed (rsync exit {rc})")
            return 20
        if rinfo is not None and kind == "video" and not a.no_check:
            rc = remote_check(n, str(src))
            if rc == 10 and not a.force:
                say("ns: the check says FAIL (capture problem). Fix it, reshoot, or pass --force to try anyway.")
                return 10
    if uploads and not a.from_stage:
        for n, _, _, _ in uploads:
            if "yes" in ssh(f"test -e {remote_run(n)}/10_frames/frames.json && echo yes", timeout=20).stdout:
                say(f"ns: runs/{n} already has finished stages; they are skipped. "
                    f"To redo from the new input use --from ingest, or pick a new --name.")
    if a.stub_cfg:
        for n in names:
            ssh(f"cat > {remote_run(n)}/stub_cfg.json", timeout=20, stdin=open(a.stub_cfg))

    flags = build_runner_flags(a)
    if a.dry_run:
        flags.append("--dry-run")
    pids = {}
    for n in names:
        ex = ssh(f"test -d {remote_run(n)}/input && echo yes", timeout=20)
        if "yes" not in (ex.stdout or "") and resume_only:
            die(f"runs/{n} does not exist on tyrone; give a video or --frames")
        if a.dry_run:
            res = ssh(f"cd {RROOT}/repo && python3 pipeline/remote/ns_remote.py {shlex.quote(n)} {' '.join(shlex.quote(f) for f in flags)}",
                      timeout=60)
            say(res.stdout.strip() or res.stderr.strip())
            continue
        pid = launch_remote(n, flags)
        if pid is None:
            say("ns: could not start the runner on tyrone")
            return 20
        pids[n] = pid
        say(f"[{stamp()}] runner for {n} {'already running; attaching' if pid == 0 else f'started (pid {pid})'}; "
            f"it keeps going if this window closes (./ns status {n})")
    if a.dry_run:
        return 0
    if a.detach:
        return 0

    try:
        results = poll_runs(pids, light_pull=not a.no_pull)
    except KeyboardInterrupt:
        say(f"\nns: stopped polling. The run continues on tyrone. Later: ./ns status {name} ; ./ns pull {name}")
        return 20
    final = 0
    prio = {0: 0, 11: 1, 30: 2, 10: 3, 20: 4}
    for n in names:
        code = results.get(n, 20)
        say(f"[{stamp()}] {n}: remote run ended with exit {code}")
        final = max(final, code, key=lambda c: prio.get(c, 4))
        if a.no_pull:
            continue
        if cmd_pull(argparse.Namespace(name=n, light=False, force=a.force, with_frames=False, with_ply=False, all=False), n, light=False) != 0:
            final = max(final, 20, key=lambda c: prio.get(c, 4))
            continue
        if code in (0, 11, 30) and a.to and a.to not in ("grid",) and not (local_run(n) / "60_export" / "export.json").exists():
            say(f"ns: stopped after {a.to} as asked (--to); no bundle, verify or report")
        elif code in (0, 11, 30):
            pc = post_pull(n)
            if pc:
                final = max(final, pc, key=lambda c: prio.get(c, 4))
        elif code == 10:
            say(f"ns: capture problem in {n}. See runs/{n}/logs/ and 10_frames/frames.json; reshoot the listed ranges.")
        else:
            say(f"ns: infrastructure problem in {n}. See runs/{n}/logs/runner.log and the stage log.")
    tj = local_run(name) / "timings.json"
    if tj.exists():
        t = json.loads(tj.read_text())
        say("timings: " + ", ".join(f"{k} {v:.0f}s" for k, v in (t.get("stages") or {}).items()) + f"; total {t.get('total', 0):.0f}s")
    summary = local_run(name) / "report.html"
    if summary.exists():
        say(f"report: {summary}")
        if a.open:
            subprocess.run(["open", str(summary)])
    if a.serve and (local_run(name) / "80_web").exists():
        serve(name, PORT)
    return final


MAC_STEP_LIMIT_S = {"bundle": 600, "verify": 1200}   # a hung Chrome or a stuck copy must not hold `ns run` forever


def run_limited(cmd: list, limit_s: float, label: str) -> int:
    """subprocess.run with a wall limit; the whole process group is killed when it is exceeded (exit 124)."""
    p = subprocess.Popen(cmd, start_new_session=True)
    try:
        return p.wait(timeout=limit_s)
    except subprocess.TimeoutExpired:
        say(f"ns: {label} ran {limit_s / 60:.0f} min (limit); stopping it")
        try:
            os.killpg(p.pid, 15)
            p.wait(timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            try:
                os.killpg(p.pid, 9)
            except OSError:
                pass
        return 124


def post_pull(name: str) -> int:
    """Mac-side steps after a pull: bundle, verify, report. Each is skipped with a message when absent.

    Returns an exit code to combine with the remote one: 20 when the bundle or report could not be built
    (nothing to ship), 30 when the viewer checks failed (a bundle exists but needs review), else 0."""
    worst = 0
    try:
        stub = bool(json.loads((local_run(name) / "60_export" / "export.json").read_text()).get("stub"))
    except (OSError, ValueError):
        stub = False
    for step, fail_code in ((cmd_bundle_run, 20), (cmd_verify_run, 30), (cmd_report_run, 20)):
        try:
            rc = step(name)
        except SystemExit:
            raise
        except Exception as exc:  # a broken step must not hide the others
            say(f"ns: {step.__name__} failed: {exc}")
            rc = 1
        if rc and stub:   # test stubs write no splats or grid images; the Mac steps cannot succeed there
            say(f"ns: {step.__name__.replace('cmd_', '').replace('_run', '')} exited {rc} on a stub run; not counted")
        elif rc:
            say(f"ns: {step.__name__.replace('cmd_', '').replace('_run', '')} exited {rc}; run exit at least {fail_code}")
            worst = fail_code if worst != 20 else worst
    return worst


def cmd_bundle_run(name: str) -> int:
    tool = REPO / "viewer" / "tools" / "bundle.py"
    if not tool.exists():
        say("bundle: viewer/tools/bundle.py not present yet (W5); skipped")
        return 0
    run = local_run(name)
    cmd = [sys.executable, str(tool), "--run", str(run), "--name", name, "--out", str(run / "80_web"), "--default"]
    prov = (json.loads((run / "input" / "meta.json").read_text()) if (run / "input" / "meta.json").exists() else {}).get("provenance", {})
    for key, flag in (("kind", "--kind"), ("license", "--license"), ("attribution", "--attribution"),
                      ("source", "--source"), ("title", "--title"), ("captured", "--captured")):
        if prov.get(key):
            cmd += [flag, str(prov[key])]
    say(f"[{stamp()}] bundle: {' '.join(shlex.quote(c) for c in cmd[1:])}")
    return run_limited(cmd, MAC_STEP_LIMIT_S["bundle"], "bundle")


def cmd_verify_run(name: str) -> int:
    tool = REPO / "viewer" / "test" / "run.mjs"
    if not tool.exists():
        say("verify: viewer/test/run.mjs not present; skipped")
        return 0
    run = local_run(name)
    if not (run / "80_web").exists():
        say("verify: no 80_web/ to verify; skipped")
        return 0
    if not shutil.which("node"):
        say("verify: node not found; skipped")
        return 0
    cmd = ["node", str(tool), "--web", str(run / "80_web"), "--out", str(run / "90_verify"), "--scene", name]
    pairs = run / "60_export" / "heldout" / "pairs.json"
    if pairs.exists():
        cmd += ["--pairs", str(pairs)]
    parity = run / "60_export" / "parity"
    if (parity / "parity.json").exists():   # gsplat renders of the shipped SD file: test H4b (browser vs gsplat)
        cmd += ["--parity", str(parity)]
    say(f"[{stamp()}] verify: {' '.join(shlex.quote(c) for c in cmd[1:])}")
    return run_limited(cmd, MAC_STEP_LIMIT_S["verify"], "verify")


def cmd_report_run(name: str) -> int:
    run = local_run(name)
    say(f"[{stamp()}] report: runs/{name}/report.json, report.html")
    rc = subprocess.run([sys.executable, "-m", "pipeline.report", "--run", str(run)], cwd=str(REPO)).returncode
    return rc


